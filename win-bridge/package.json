{
  "name": "dsh-mobile-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RikkaHub × DSH 双向桥：把 DSH 工具以 HTTP 端点暴露给手机，并把手机侧工具注册回 DSH。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./protocol": "./lib/protocol.js",
    "./schema": "./lib/schema.js",
    "./client": "./lib/client.js",
    "./mcp": "./lib/mcp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs && node test/e2e.mjs && node test/mcp.mjs",
    "test:host": "node test/host-load.mjs",
    "test:all": "npm test && npm run test:host"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true }
  },
  "license": "MIT"
}
